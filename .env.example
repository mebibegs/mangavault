# Public site URL used by queue workers and metadata.
NEXT_PUBLIC_BASE_URL=https://www.mangavault.in

# MongoDB catalog database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?appName=Cluster0
MONGODB_DB=mangavault

# Secret used to authenticate cron/admin endpoints.
# Generate with: openssl rand -base64 48
CRON_SECRET=

# CSRF HMAC secret. Must be at least 64 hex characters.
# Generate with: openssl rand -hex 32
CSRF_SECRET=

# Image proxy token encryption/signing. Each must be exactly 64 hex characters.
# Generate each with: openssl rand -hex 32
IMAGE_PROXY_SECRET=
IMAGE_HMAC_SECRET=

# Upstash Redis for distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash for background sync workers.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional for multi-region QStash signature verification.
QSTASH_REGION=

# Optional runtime tuning.
MAX_SYNC_PAGES=3600
IMAGE_TOKEN_TTL=3600
ALLOWED_IMAGE_DOMAINS=
SCRAPINGANT_KEY=
