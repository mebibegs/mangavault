--- .gitignore (原始)
# dependencies
node_modules/

# Next.js
.next/
out/

# production builds
build/
dist/

# local env files
.env
.env.*
!.env.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor
.DS_Store
.idea/
.vscode/

# caches
.cache/
.eslintcache
*.tsbuildinfo

# scraper runtime state
scripts/.resync-gaps-state.json
scripts/*.log

